{
  "name": "klf-200-api",
  "version": "7.0.0",
  "description": "This module provides a wrapper to the socket API of a Velux KLF-200 interface. You will need at least firmware 0.2.0.0.71 on your KLF interface for this library to work.",
  "main": "dist/index.js",
  "author": {
    "name": "Michael Schroeder"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@types/promise-timeout": "^1.3.3",
    "debug": "^4.4.3",
    "disposablestack": "^1.1.7",
    "promise-timeout": "^1.3.0"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^10.0.1",
    "@sinonjs/fake-timers": "^14.0.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/debug": "^4.1.12",
    "@types/deep-eql": "^4.0.2",
    "@types/mitm": "^1.3.8",
    "@types/node": "^22.15.18",
    "cross-env": "^7.0.3",
    "deep-eql": "^5.0.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.1",
    "nock": "^13.5.6",
    "prettier": "^3.6.2",
    "shx": "^0.4.0",
    "source-map-support": "^0.5.21",
    "tsx": "^4.22.4",
    "typedoc": "^0.28.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.32.1"
  },
  "scripts": {
    "compile": "tsc -b ./tsconfig.json",
    "build:clean": "rm -rf ./dist",
    "build": "npm run build:clean && npm run compile && shx cp ./velux-cert.pem ./dist/velux-cert.pem",
    "watch": "tsc --watch",
    "test": "cross-env DEBUG=-mockServer*,-klf-200-api:products*,-klf-200-api:connection*,-klf-200-api:KLF200SocketProtocol,-klf-200-api:gateway*,-connection-test node --enable-source-maps --import tsx --test --test-concurrency=1 --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info 'test/**/*.ts'",
    "lint": "eslint --ext .ts src test",
    "release": "release-script",
    "document": "typedoc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MiSchroe/klf-200-api.git"
  },
  "keywords": [
    "klf-200",
    "klf200",
    "VELUX",
    "IoT"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/MiSchroe/klf-200-api/issues"
  },
  "homepage": "https://mischroe.github.io/klf-200-api/",
  "readme": "./README.md",
  "files": [
    "dist"
  ],
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
